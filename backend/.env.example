# Copy this file to ".env" and put your own values. NEVER commit ".env".

PORT=5000
NODE_ENV=development

# MySQL connection. Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If your password has special characters like @ or #, URL-encode them (@ = %40, # = %23).
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/my_app_db"

# Long random text (at least 32 characters). Used to sign login tokens.
JWT_SECRET="change_this_to_a_long_random_text_32_chars_or_more"
JWT_EXPIRES_IN=1d

# The address of the React app (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Queue rules
ENFORCE_WORKING_HOURS=true     # set false to demo virtual tokens outside office hours
MAX_ADVANCE_DAYS=7             # how many days ahead a citizen can book
CALL_AHEAD_MINUTES=30          # an appointment token can be called this many minutes before its slot
CANCEL_BEFORE_MINUTES=30       # appointment tokens cannot be cancelled inside this window
NOTIFY_WHEN_AHEAD=2            # "your turn is near" notification when this many people are ahead

# Used ONLY by "npm run db:seed" to create the first administrator and demo accounts
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@smartq.demo"
ADMIN_PASSWORD="ChangeMe@123"
DEMO_PASSWORD="Demo@12345"

# OPTIONAL email notifications. Leave SMTP_HOST empty to use in-app notifications only.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SmartQ <no-reply@smartq.demo>"
